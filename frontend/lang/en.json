      "name": "Marketing",
      "desc": "Campaign brief, budget estimate and channels.",
      "button": "Open",
      "fields": [
        {"key":"objective","type":"text","label":"Main objective","placeholder":"e.g. acquisition / awareness","required":true},
        {"key":"audience","type":"text","label":"Target audience","placeholder":"e.g. 18-35, urban"},
        {"key":"budget","type":"text","label":"Estimated budget","placeholder":"e.g. 1,200,000 XOF"},
        {"key":"channels","type":"textarea","label":"Planned channels","placeholder":"TV, radio, digital..."}
      ]
    },
    {
      "name": "Funding",
      "desc": "Structured funding request, financial models.",
      "button": "Open",
      "fields": [
        {"key":"amount","type":"text","label":"Requested amount","placeholder":"e.g. 20,000,000 XOF","required":true},
        {"key":"use_of_funds","type":"textarea","label":"Use of funds","placeholder":"What will the money be used for?"},
        {"key":"term","type":"select","label":"Desired term","options":[{"label":"6 months","value":"6m"},{"label":"12 months","value":"12m"},{"label":"24 months","value":"24m"}]}
      ]
    },
    {
      "name": "Recruitment",
      "desc": "Role brief, budget and timeline.",
      "button": "Open",
      "fields": [
        {"key":"role","type":"text","label":"Role","placeholder":"e.g. Project Manager","required":true},
        {"key":"team_size","type":"text","label":"Team size","placeholder":"e.g. 3 people"},
        {"key":"salary","type":"text","label":"Salary budget","placeholder":"e.g. XOF / month"}
      ]
    },
    {
      "name": "Product",
      "desc": "Positioning, pricing, GTM.",
      "button": "Open",
      "fields": [
        {"key":"value","type":"textarea","label":"Value proposition","placeholder":"Why this product?","required":true},
        {"key":"price_model","type":"text","label":"Pricing model","placeholder":"e.g. subscription / one-time"},
        {"key":"launch_date","type":"text","label":"Planned launch","placeholder":"YYYY-MM"}
      ]
    }
  ]
