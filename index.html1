<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title data-i18n="meta.title">e-META — Assistant IA</title>

  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="rtl.css" id="rtlStylesheet" disabled />
</head>

<body id="top">

<!-- =========================
     HEADER
========================== -->
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="#top">
      <span class="logo-mark">e</span>
      <span class="logo-text">META</span>
      <span class="logo-tagline" data-i18n="header.tagline">
        Assistant IA multilingue de prise de décision
      </span>
    </a>

    <button class="burger" id="burgerBtn" type="button" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="mainNav">
      <a href="#top" data-i18n="nav.home">Accueil</a>
      <a href="#form" data-i18n="nav.form">Formulaire</a>
      <a href="privacy.html" data-i18n="nav.privacy">Confidentialité</a>
    </nav>

    <div class="header-actions">
      <select class="lang-select" id="langSelect" aria-label="Langue">
        <option value="fr">FR</option>
        <option value="en">EN</option>
        <option value="es">ES</option>
        <option value="ar">AR</option>
      </select>

      <button
        class="cta-custom"
        type="button"
        id="customBtn"
        data-i18n="cta.custom">
        Requête personnalisée
      </button>
    </div>
  </div>
</header>

<main>

<!-- =========================
     HERO
========================== -->
<section class="hero" id="hero">
  <div class="container hero-grid">

    <div class="hero-box">
      <h1 data-i18n="hero.title"></h1>
      <p class="hero-subtitle" data-i18n="header.tagline"></p>
      <p class="hero-subtitle" data-i18n="hero.subtitle"></p>

      <ul class="hero-points">
        <li data-i18n="hero.point1"></li>
        <li data-i18n="hero.point2"></li>
        <li data-i18n="hero.point3"></li>
      </ul>

      <button
        class="cta-primary"
        type="button"
        id="startBtn"
        data-i18n="hero.cta">
        Commencer une analyse stratégique
      </button>
    </div>

    <div class="hero-box muted">
      <div class="hero-badge">
        <span class="badge-title" data-i18n="hero.badge.title"></span>
        <span class="badge-text" data-i18n="hero.badge.text"></span>
      </div>
      <p class="hero-note" data-i18n="hero.note"></p>
    </div>

  </div>
</section>

<!-- =========================
     FORM SECTION
========================== -->
<section id="form">
  <div class="container">

    <header class="form-header">
      <h2 class="section-title" data-i18n="form.title"></h2>

      <div class="form-badge">
        🧠 <span data-i18n="form.badge.cabinet"></span>
      </div>

      <p class="form-intro" data-i18n="form.intro"></p>
    </header>

    <!-- =========================
         FORMULAIRE (UNIQUE)
    ========================== -->
    <form id="emetaForm" class="emeta-form" novalidate>

      <!-- ÉTAPE 1 -->
      <fieldset class="field-group">
        <legend class="field-legend" data-i18n="group.general"></legend>

        <div class="grid-2">
          <div class="field">
            <label for="domain" data-i18n="field.domain.label"></label>
            <select id="domain" name="domain" required>
              <option value="" data-i18n="field.domain.placeholder"></option>
              <option value="strategy" data-i18n="field.domain.strategy"></option>
              <option value="finance" data-i18n="field.domain.finance"></option>
              <option value="marketing" data-i18n="field.domain.marketing"></option>
              <option value="operations" data-i18n="field.domain.operations"></option>
              <option value="it" data-i18n="field.domain.it"></option>
              <option value="legal" data-i18n="field.domain.legal"></option>
              <option value="impact" data-i18n="field.domain.impact"></option>
              <option value="other" data-i18n="field.domain.other"></option>
            </select>
          </div>

          <div class="field">
            <label for="decisionType" data-i18n="field.decisionType.label"></label>
            <select id="decisionType" name="decisionType" required>
              <option value="" data-i18n="field.decisionType.placeholder"></option>
              <option value="t1" data-i18n="field.decisionType.t1"></option>
              <option value="t2" data-i18n="field.decisionType.t2"></option>
              <option value="t3" data-i18n="field.decisionType.t3"></option>
              <option value="t4" data-i18n="field.decisionType.t4"></option>
              <option value="t5" data-i18n="field.decisionType.t5"></option>
              <option value="t6" data-i18n="field.decisionType.t6"></option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="decisionTitle" data-i18n="field.title.label"></label>
          <input id="decisionTitle" name="decisionTitle" type="text"
                 data-i18n-placeholder="field.title.ph" />
          <div class="hint" data-i18n="field.title.hint"></div>
        </div>
      </fieldset>

      <!-- 🔽 LES AUTRES FIELDSETS (analysis, budget, output, trust, actions)
           SONT À LAISSER STRICTEMENT IDENTIQUES
           → tu peux les recoller ici SANS RIEN CHANGER
      --><fieldset class="field-group">
          <legend data-i18n="group.analysis"></legend>

          <div class="field">
  <label for="problem" data-i18n="field.problem.label"></label>

  <textarea
  id="problem"
  name="problem"
  rows="4"
  data-i18n-placeholder="field.problem.ph"
  placeholder="">
</textarea>

<div class="hint subtle" data-i18n="help.problem"></div>
</div>

          <div class="grid-2">
            <div class="field">
              <label for="objectives" data-i18n="field.objectives.label"></label>
              <textarea id="objectives" name="objectives" rows="4" data-i18n-placeholder="field.objectives.ph"></textarea>
            </div>
            <div class="field">
              <label for="constraints" data-i18n="field.constraints.label"></label>
              <textarea id="constraints" name="constraints" rows="4" data-i18n-placeholder="field.constraints.ph"></textarea>
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="kpis" data-i18n="field.kpis.label"></label>
              <textarea id="kpis" name="kpis" rows="4" data-i18n-placeholder="field.kpis.ph"></textarea>
            </div>
            <div class="field">
              <label for="resources" data-i18n="field.resources.label"></label>
              <textarea id="resources" name="resources" rows="4" data-i18n-placeholder="field.resources.ph"></textarea>
            </div>
          </div>

          <div class="field">
            <label for="context" data-i18n="field.context.label"></label>
            <textarea id="context" name="context" rows="5" data-i18n-placeholder="field.context.ph"></textarea>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend data-i18n="group.budget"></legend>

          <div class="grid-2">
            <div class="field">
              <label for="budgetMin" data-i18n="field.budgetMin.label"></label>
              <div class="field-with-unit">
                <input id="budgetMin" name="budgetMin" type="number" min="0" step="1" data-i18n-placeholder="field.budgetMin.ph" />
                <select id="currency" name="currency">
                  <option value="XOF">XOF</option>
                  <option value="EUR">EUR</option>
                  <option value="USD">USD</option>
                  <option value="GBP">GBP</option>
                </select>
              </div>
            </div>

            <div class="field">
              <label for="budgetMax" data-i18n="field.budgetMax.label"></label>
              <input id="budgetMax" name="budgetMax" type="number" min="0" step="1" data-i18n-placeholder="field.budgetMax.ph" />
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="deadline" data-i18n="field.deadline.label"></label>
              <input id="deadline" name="deadline" type="text" data-i18n-placeholder="field.deadline.ph" />
            </div>

            <div class="field">
              <label for="urgency" data-i18n="field.urgency.label"></label>
              <input id="urgency" name="urgency" type="range" min="1" max="5" value="3" />
              <div class="range-labels">
                <span data-i18n="field.urgency.low"></span>
                <span data-i18n="field.urgency.medium"></span>
                <span data-i18n="field.urgency.high"></span>
              </div>
            </div>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend data-i18n="group.output"></legend>

          <div class="field">
            <div class="field-label-strong" data-i18n="field.outputMode.label"></div>
            <div class="checkbox-grid">
              <label class="check-item"><input type="checkbox" name="out_email" value="1" /><span data-i18n="field.outputMode.email"></span></label>
              <label class="check-item"><input type="checkbox" name="out_whatsapp" value="1" /><span data-i18n="field.outputMode.whatsapp"></span></label>
              <label class="check-item"><input type="checkbox" name="out_pdf" value="1" /><span data-i18n="field.outputMode.pdf"></span></label>
              <label class="check-item"><input type="checkbox" name="out_display" value="1" /><span data-i18n="field.outputMode.display"></span></label>
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label for="email" data-i18n="field.email.label"></label>
              <input id="email" name="email" type="email" data-i18n-placeholder="field.email.ph" />
            </div>
            <div class="field">
              <label for="whatsapp" data-i18n="field.whatsapp.label"></label>
              <input id="whatsapp" name="whatsapp" type="tel" data-i18n-placeholder="field.whatsapp.ph" />
            </div>
          </div>

          <div class="field">
            <label for="fileLink" data-i18n="field.fileLink.label"></label>
            <input id="fileLink" name="fileLink" type="url" data-i18n-placeholder="field.fileLink.ph" />
            <div class="hint" data-i18n="field.fileLink.hint"></div>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend data-i18n="group.trust"></legend>
          <label class="check-item">
            <input type="checkbox" id="consent" name="consent" required />
            <span data-i18n="field.consent.label"></span>
          </label>
        </fieldset>

        <div class="form-actions">
          <button
  type="submit"
  class="btn-submit"
  data-i18n="form.submit"
  disabled>
</button>

<button
  type="reset"
  class="btn-secondary"
  data-i18n="form.reset">
</button>
        </div>
      </form>
    </div>
  </section>

    </form>

  </div>
</section>

<!-- =========================
     HELP ICONS — GLOBAL
========================== -->
<div class="help-icons">
  <a
    id="pdfPrivacyLink"
    class="help-icon help-privacy"
    data-i18n="help.privacy"
    href="privacy.html"
    target="_blank"
    rel="noopener"
    aria-label="Politique de confidentialité">
  </a>

  <a
    id="pdfGuideLink"
    class="help-icon help-guide"
    data-i18n="help.guide"
    target="_blank"
    rel="noopener"
    aria-label="Guide officiel">
  </a>
</div>

</main>

<!-- =========================
     FOOTER
========================== -->
<footer class="site-footer">
  <div class="container footer-inner">
    <p data-i18n="footer.text"></p>
    <a class="footer-link" href="privacy.html" data-i18n="footer.privacy"></a>
    <p class="footer-copy" data-i18n="footer.copy"></p>
  </div>
</footer>

<script src="i18n.js"></script>
<script src="script.js"></script>
</body>
</html>
