<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>e-META — Decision Intelligence</title>
  <meta name="theme-color" content="#0b1020" />

  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="rtl.css" id="rtlStylesheet" disabled />
</head>

<body>

<!-- ================= HEADER ================= -->
<header class="site-header">
  <div class="container header-inner">

    <a href="#home" class="logo">
      <span class="logo-mark">e</span>
      <span class="logo-text">META</span>
      <span class="logo-tagline" data-i18n="tagline">
        Assistant IA multilingue de prise de décision
      </span>
    </a>

    <button class="burger" id="burgerBtn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="mainNav">
      <ul>
        <li><a href="#home" data-i18n="nav.home">Accueil</a></li>
        <li><a href="#form" data-i18n="nav.form">Formulaire</a></li>
        <li><a href="privacy.html" data-i18n="nav.privacy">Confidentialité</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <select id="languageSwitcher" class="lang-select">
        <option value="fr">FR</option>
        <option value="en">EN</option>
        <option value="ar">ع</option>
      </select>

      <a href="#form" class="btn-whatsapp" data-i18n="cta.custom">
        Requête personnalisée
      </a>
    </div>

  </div>
</header>

<!-- ================= HERO ================= -->
<section class="hero" id="home">
  <div class="container hero-inner">

    <div class="hero-text">
      <h1 data-i18n="hero.title" class="hero-title">
        Donnez à vos décisions le niveau d’un cabinet de consulting premium
      </h1>

      <p class="hero-subtitle" data-i18n="hero.subtitle"></p>
      <p class="hero-subtext" data-i18n="hero.claim"></p>

      <div class="hero-cta">
        <button id="ctaStart" class="cta-primary" data-i18n="cta.start">
          Démarrer une analyse stratégique
        </button>
      </div>

      <ul class="hero-points">
        <li data-i18n="hero.point1"></li>
        <li data-i18n="hero.point2"></li>
        <li data-i18n="hero.point3"></li>
      </ul>
    </div>

    <div class="hero-panel">
      <div class="hero-badge">
        <span class="badge-title" data-i18n="hero.badge.title"></span>
        <span class="badge-text" data-i18n="hero.badge.text"></span>
      </div>
      <p class="hero-note" data-i18n="hero.note"></p>
    </div>

  </div>
</section>

<!-- ================= PROBLEM ================= -->
<section class="form-section">
  <div class="container">

    <h2 class="section-title" data-i18n="problem_title"></h2>
    <p class="section-intro" data-i18n="problem_intro"></p>

    <ul class="problem-list">
      <li data-i18n="problem_1"></li>
      <li data-i18n="problem_2"></li>
      <li data-i18n="problem_3"></li>
    </ul>

    <p class="section-intro" data-i18n="problem_transition"></p>

  </div>
</section>

<!-- ================= FORM ================= -->
<section id="form" class="form-section">
  <div class="container">

    <h2 data-i18n="form.title"></h2>
    <p class="section-intro" data-i18n="form.intro"></p>

    <form id="emetaForm" novalidate>

      <!-- MODE DE RESTITUTION -->
      <fieldset class="field-group">
        <legend data-i18n="form.delivery.title"></legend>

        <div class="checkbox-grid">
          <label><input type="checkbox"> <span data-i18n="form.delivery.email"></span></label>
          <label><input type="checkbox"> <span data-i18n="form.delivery.whatsapp"></span></label>
          <label><input type="checkbox"> <span data-i18n="form.delivery.pdf"></span></label>
          <label><input type="checkbox"> <span data-i18n="form.delivery.screen"></span></label>
        </div>

        <div class="field-inline">
          <div class="field">
            <label data-i18n="form.email"></label>
            <input type="email" placeholder="email@example.com">
          </div>
          <div class="field">
            <label data-i18n="form.whatsapp"></label>
            <input type="tel" placeholder="+221xxxxxxxxx">
          </div>
        </div>

        <div class="field">
          <label data-i18n="form.link"></label>
          <input type="url" placeholder="Google Drive, Dropbox, PDF…">
        </div>

        <label class="checkbox-row">
          <input type="checkbox" required>
          <span data-i18n="form.consent"></span>
        </label>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn-primary" data-i18n="form.send"></button>
        <button type="reset" class="btn-secondary" data-i18n="form.reset"></button>
      </div>

    </form>
  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy" data-i18n="footer.text"></p>
    <a href="privacy.html" class="footer-link" data-i18n="footer.privacy"></a>
  </div>
</footer>

<script src="script.js"></script>
</body>
</html>
