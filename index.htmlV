<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>e-META — Decision Intelligence Engine</title>

  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="rtl.css" id="rtlStylesheet" disabled />
</head>

<body>

<!-- ================= HEADER ================= -->
<header class="site-header">
  <div class="container header-inner">

    <a href="index.html" class="logo">
      <span class="logo-mark">e</span><span class="logo-text">META</span>
      <span class="logo-tagline" data-i18n="tagline"></span>
    </a>

    <button class="burger" id="burgerBtn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="mainNav">
      <ul>
        <li><a href="#hero" data-i18n="nav.home"></a></li>
        <li><a href="#form" data-i18n="nav.form"></a></li>
        <li><a href="privacy.html" data-i18n="nav.privacy"></a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <select id="languageSwitcher">
        <option value="fr">FR</option>
        <option value="en">EN</option>
        <option value="ar">ع</option>
      </select>

      <button class="btn-whatsapp" data-i18n="btn.custom"></button>
    </div>

  </div>
</header>

<!-- ================= HERO ================= -->
<section id="hero" class="hero">
  <div class="container hero-inner">

    <div class="hero-text">
      <h1 data-i18n="hero.title"></h1>
      <p class="hero-subtitle" data-i18n="hero.subtitle"></p>
      <p class="hero-subtext" data-i18n="hero.claim"></p>

      <div class="hero-cta">
        <button id="ctaStart" class="cta-primary" data-i18n="cta.start"></button>
      </div>

      <ul class="hero-points">
        <li data-i18n="hero.point1"></li>
        <li data-i18n="hero.point2"></li>
        <li data-i18n="hero.point3"></li>
      </ul>
    </div>

    <div class="hero-panel">
      <div class="hero-badge">
        <span class="badge-title" data-i18n="hero.badge.title"></span>
        <span class="badge-text" data-i18n="hero.badge.text"></span>
      </div>
      <p class="hero-note" data-i18n="hero.note"></p>
    </div>

  </div>
</section>

<!-- ================= PROBLEM + FORM ================= -->
<section id="form" class="form-section">
  <div class="container">

    <h2 class="section-title" data-i18n="problem_title"></h2>
    <p class="section-intro" data-i18n="problem_intro"></p>

    <ul class="problem-list">
      <li data-i18n="problem_1"></li>
      <li data-i18n="problem_2"></li>
      <li data-i18n="problem_3"></li>
    </ul>

    <p class="section-transition" data-i18n="problem_transition"></p>

    <h2 class="form-title" data-i18n="form.title"></h2>
    <p class="form-intro" data-i18n="form.intro"></p>

    <!-- ⚠️ FORMULAIRE CONSERVÉ (Make compatible) -->
    <!-- TON FORMULAIRE COMMENCE ICI – INCHANGÉ DANS LES name="" -->
    <!-- ... (le reste de ton formulaire est déjà correct et reste tel quel) -->

  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="site-footer">
  <div class="container footer-inner">
    <p data-i18n="footer.text"></p>
    <a href="privacy.html" data-i18n="footer.privacy"></a>
    <p>© e-META 2025</p>
  </div>
</footer>

<!-- ================= SCRIPT ================= -->
<script src="script.js"></script>
</body>
</html>
