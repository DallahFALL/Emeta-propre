    },
    {
      "parameters": {
        "jsCode": "const body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst question = typeof body.question === 'string' ? body.question.trim() : typeof body.message === 'string' ? body.message.trim() : '';\nif (!question) throw new Error('Le champ question ou message doit contenir du texte.');\nreturn { json: { question } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        0
      ],
      "id": "1cae8952-989c-438f-b0b8-6f9bcbb5d094",
      "name": "Normalize query"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GOOGLE_API_KEY }}"
