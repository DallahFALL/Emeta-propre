                  {
                      "id":  "77000000-0000-4000-8000-000000000007",
                      "name":  "Préparer Consignation \u0026 Relais Production",
                      "parameters":  {
                                         "jsCode":  "const ipn = $(\u0027Normaliser IPN PayTech PayDunya PayPal\u0027).first().json;\nconst resp = $input.first().json || {};\nconst rec = (resp.records || resp.list || [])[0];\nif (!rec) throw new Error(`Dossier ${ipn.reference_mission} introuvable.`);\n\nconst f = rec.fields || rec;\nconst recordId = Number(rec.id || rec.id_fields?.Id || f.Id);\nconst palier = String(f.Palier_Mandat || \u0027Palier_2_Certifie\u0027);\nconst isOptionB = ipn.type_flux === \u0027OPTION_B_DEVIS\u0027;\n\n// Génération du Code Pack pour les achats Paliers 02 (3 missions -\u003e 2 restantes après celle-ci) et 03 (10 -\u003e 9 restantes)\nconst suffix = String(Math.floor(100000 + Math.random() * 900000));\nconst isP3 = /palier_3|chambre/i.test(palier);\nconst generatedPackCode = isOptionB\n  ? (f.Code_Pack || \u0027\u0027)\n  : (isP3 ? `CHAMBRE-P3-${suffix}` : `PACK-P2-${suffix}`);\nconst remainingMissions = isOptionB\n  ? Number(f.Missions_Restantes || 0)\n  : (isP3 ? 9 : 2);\n\nconst missionPatch = [{\n  id: recordId,\n  fields: {\n    Statut_Mandat: isOptionB ? \u0027Sequestre_Consigne\u0027 : \u0027Saisine_Recue\u0027,\n    Statut_Sequestre: ipn.statut_sequestre,\n    Operateur_Paiement: ipn.operateur_paiement,\n    Transaction_Ref: ipn.transaction_ref,\n    Montant_Total: ipn.montant_total,\n    Devise: ipn.devise,\n    Quote_Part_Expert: ipn.quote_part_expert,\n    Commission_Emeta: ipn.commission_emeta,\n    Code_Pack: generatedPackCode,\n    Missions_Restantes: remainingMissions\n  }\n}];\n\nreturn [{\n  json: {\n    mission_patch: missionPatch,\n    code_pack: generatedPackCode,\n    missions_restantes: remainingMissions,\n    cortex02_payload: {\n      reference_mission: ipn.reference_mission,\n      mission_ref: ipn.reference_mission,\n      nocodb_record_id: recordId,\n      palier_mandat: palier,\n      secteur_code: f.Secteur_Code || \u0027agro\u0027,\n      langue: f.Langue_Dossier || \u0027fr\u0027,\n      mission_nom: f.Title || ipn.reference_mission,\n      mission_contexte: f.Contexte_Extrait || \u0027\u0027,\n      empreinte_sha256: f.Empreinte_SHA256 || \u0027\u0027,\n      code_pack: generatedPackCode,\n      missions_restantes: remainingMissions\n    }\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
