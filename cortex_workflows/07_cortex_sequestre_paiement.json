                  {
                      "id":  "77000000-0000-4000-8000-000000000002",
                      "name":  "Calculer Grille \u0026 Passerelle",
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first().json || {};\nconst body = raw.body \u0026\u0026 typeof raw.body === \u0027object\u0027 ? raw.body : raw;\nconst ref = String(body.reference_mission || body.ref || \u0027\u0027).trim().toUpperCase();\nif (!/^MIS-20\\d{2}-\\d{3,6}$/.test(ref)) throw new Error(\u0027Référence mission invalide.\u0027);\n\nconst palier = String(body.palier || \u0027Palier_2_Certifie\u0027).trim();\nconst devise = String(body.devise || body.currency || \u0027XOF\u0027).trim().toUpperCase();\nconst isOptionBDevis = String(body.type_flux || \u0027\u0027).toUpperCase() === \u0027OPTION_B_DEVIS\u0027 || Number(body.montant_devis_option_b || 0) \u003e 0;\nconst agreedOptionBAmount = Number(body.montant_devis_option_b || body.montant_devis || 0);\n\nlet montant = 0;\nlet quotaMissions = /palier_3|chambre/i.test(palier) ? 10 : (/palier_2|certifi/i.test(palier) ? 3 : 1);\nlet typeFlux = \u0027PALIER_AUDIT\u0027;\n\nif (isOptionBDevis) {\n  if (agreedOptionBAmount \u003c= 0) {\n    throw new Error(\u0027Option B : le montant convenu entre le Client et l’Expert (montant_devis_option_b) doit être supérieur à 0.\u0027);\n  }\n  typeFlux = \u0027OPTION_B_DEVIS\u0027;\n  montant = agreedOptionBAmount;\n} else if (/palier_1|decouver/i.test(palier)) {\n  montant = 0;\n} else if (/palier_3|chambre/i.test(palier)) {\n  montant = devise === \u0027XOF\u0027 ? 950000 : (devise === \u0027USD\u0027 ? 1580 : 1450);\n} else {\n  montant = devise === \u0027XOF\u0027 ? 185000 : (devise === \u0027USD\u0027 ? 305 : 280);\n}\n\nconst requestedGateway = String(body.passerelle || \u0027\u0027).toLowerCase();\nlet operateur = \u0027Offert_Palier_1\u0027;\nif (montant \u003e 0) {\n  if (devise === \u0027XOF\u0027) {\n    operateur = requestedGateway === \u0027paydunya\u0027 ? \u0027PayDunya\u0027 : \u0027PayTech\u0027;\n  } else {\n    operateur = \u0027PayPal\u0027;\n  }\n}\n\n// Règle financière : Palier 02 et Palier 03 = 100% E-META LABS SASU | Option B (devis convenu) = 85% Expert / 15% Commission E-META\nconst quotePartExpert = typeFlux === \u0027OPTION_B_DEVIS\u0027 ? Math.round(montant * 0.85 * 100) / 100 : 0;\nconst commissionEmeta = Math.round((montant - quotePartExpert) * 100) / 100;\n\nreturn [{\n  json: {\n    ok: true,\n    reference_mission: ref,\n    type_flux: typeFlux,\n    palier,\n    devise,\n    montant_total: montant,\n    quota_missions: quotaMissions,\n    quote_part_expert: quotePartExpert,\n    commission_emeta: commissionEmeta,\n    operateur_paiement: operateur,\n    statut_sequestre: montant === 0 ? \u0027Non_Requis\u0027 : \u0027Attente_Paiement\u0027,\n    ipn_callback_url: \u0027https://automation.e-metalabs.com/webhook/ipn-sequestre\u0027,\n    success_return_url: `https://e-metalabs.com/tracker.html?ref=${encodeURIComponent(ref)}`\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       260,
                                       120
                                   ],
                      "typeVersion":  2
