                  {
                      "id":  "77000000-0000-4000-8000-000000000005",
                      "name":  "Normaliser IPN PayTech PayDunya PayPal",
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first().json || {};\nconst b = raw.body \u0026\u0026 typeof raw.body === \u0027object\u0027 ? raw.body : raw;\n\nlet operateur = \u0027PayTech\u0027;\nlet ref = \u0027\u0027;\nlet txId = \u0027\u0027;\nlet amount = 0;\nlet currency = \u0027XOF\u0027;\nlet typeFlux = \u0027PALIER_AUDIT\u0027;\nlet paid = false;\n\nif (b.event_type \u0026\u0026 String(b.event_type).includes(\u0027PAYMENT.CAPTURE.COMPLETED\u0027)) {\n  operateur = \u0027PayPal\u0027;\n  const res = b.resource || {};\n  ref = String(res.custom_id || res.invoice_id || \u0027\u0027).trim().toUpperCase();\n  txId = String(res.id || \u0027\u0027).trim();\n  amount = Number(res.amount?.value || 0);\n  currency = String(res.amount?.currency_code || \u0027EUR\u0027).toUpperCase();\n  if (String(res.description || \u0027\u0027).toUpperCase().includes(\u0027OPTION_B\u0027)) typeFlux = \u0027OPTION_B_DEVIS\u0027;\n  paid = true;\n} else if (b.data \u0026\u0026 (b.data.invoice || b.data.custom_data)) {\n  operateur = \u0027PayDunya\u0027;\n  const d = b.data;\n  ref = String(d.custom_data?.reference_mission || d.invoice?.description || \u0027\u0027).match(/MIS-20\\d{2}-\\d{3,6}/i)?.[0]?.toUpperCase() || \u0027\u0027;\n  txId = String(d.invoice?.token || d.hash || \u0027\u0027).trim();\n  amount = Number(d.invoice?.total_amount || 0);\n  currency = \u0027XOF\u0027;\n  if (String(d.custom_data?.type_flux || \u0027\u0027).toUpperCase() === \u0027OPTION_B_DEVIS\u0027) typeFlux = \u0027OPTION_B_DEVIS\u0027;\n  paid = String(d.status || \u0027\u0027).toLowerCase() === \u0027completed\u0027;\n} else {\n  operateur = \u0027PayTech\u0027;\n  const custom = typeof b.custom_field === \u0027string\u0027 ? JSON.parse(b.custom_field || \u0027{}\u0027) : (b.custom_field || {});\n  ref = String(custom.reference_mission || b.ref_command || \u0027\u0027).match(/MIS-20\\d{2}-\\d{3,6}/i)?.[0]?.toUpperCase() || \u0027\u0027;\n  txId = String(b.token || b.payment_method || b.ref_command || \u0027\u0027).trim();\n  amount = Number(b.item_price || b.final_item_price || 0);\n  currency = String(b.currency || \u0027XOF\u0027).toUpperCase();\n  if (String(custom.type_flux || b.type_flux || \u0027\u0027).toUpperCase() === \u0027OPTION_B_DEVIS\u0027) typeFlux = \u0027OPTION_B_DEVIS\u0027;\n  paid = /sale_complete|completed|success/i.test(String(b.type_event || b.status || \u0027sale_complete\u0027));\n}\n\nif (!paid || !/^MIS-20\\d{2}-\\d{3,6}$/.test(ref)) {\n  throw new Error(`Notification IPN ignorée ou référence absente (ref=${ref}, paid=${paid}).`);\n}\n\n// 100% E-META LABS sur Paliers 02/03 ; 85% Expert / 15% Commission E-META uniquement sur Devis Option B convenu\nconst quotePartExpert = typeFlux === \u0027OPTION_B_DEVIS\u0027 ? Math.round(amount * 0.85 * 100) / 100 : 0;\nconst commissionEmeta = Math.round((amount - quotePartExpert) * 100) / 100;\n\nreturn [{\n  json: {\n    reference_mission: ref,\n    type_flux: typeFlux,\n    operateur_paiement: operateur,\n    transaction_ref: txId,\n    montant_total: amount,\n    devise: currency,\n    quote_part_expert: quotePartExpert,\n    commission_emeta: commissionEmeta,\n    statut_sequestre: typeFlux === \u0027OPTION_B_DEVIS\u0027 ? \u0027Consigne\u0027 : \u0027Encaisse_Emeta_100\u0027\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
                      "type":  "n8n-nodes-base.code",
                      "position":  [
                                       260,
                                       380
                                   ],
                      "typeVersion":  2
                  },
