        "jsCode": "try {\n  const sequence = Number($json.mission_sequence);\n  const source = $('Empreinte SHA-256').first();\n  if (!Number.isSafeInteger(sequence) || sequence < 1 || sequence > 9999) throw new Error('Séquence de référence invalide ou quota annuel MIS-2026 épuisé.');\n  const reference = `MIS-2026-${String(sequence).padStart(4, '0')}`;\n  return { json: { ...source.json, reference_mission: reference }, binary: source.binary };\n} catch (err) { throw new Error(`Génération de référence impossible: ${err.message}`); }"
