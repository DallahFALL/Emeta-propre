                                         "specifyBody":  "json",
                                         "jsonBody":  "={{\n  (() =\u003e {\n    let payload = {};\n    try {\n      payload = typeof $json.canonical_payload === \u0027string\u0027\n        ? JSON.parse($json.canonical_payload)\n        : ($json.canonical_payload || {});\n    } catch (_) {}\n\n    const norm = (v) =\u003e String(v || \u0027\u0027).normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toLowerCase().trim();\n    const pNorm = norm(payload.palier);\n\n    let palierCode = \u0027Palier_2_Certifie\u0027;\n    let isFreeOrPack = Boolean(String(payload.pack_code || \u0027\u0027).trim());\n\n    if (/decouver|palier_1|option a|p1/.test(pNorm)) {\n      palierCode = \u0027Palier_1_Decouverte\u0027;\n      isFreeOrPack = true;\n    } else if (/chambre|palier_3|option c|p3|souverain/.test(pNorm)) {\n      palierCode = \u0027Palier_3_Chambre\u0027;\n    }\n\n    const contexte = String(payload.mission_contexte || payload.contexte || \u0027\u0027).trim();\n    const title = String(\n      payload.mission_nom || payload.entreprise || (contexte ? contexte.slice(0, 120) : \u0027Saisine CORTEX\u0027)\n    ).trim();\n    const secteurCode = norm(payload.secteur_selectionne || payload.secteur || \u0027agro\u0027) || \u0027agro\u0027;\n\n    return {\n      fields: {\n        Title: title,\n        Mission_Ref: $json.reference_mission,\n        Palier_Mandat: palierCode,\n        Secteur_Code: secteurCode,\n        Langue_Dossier: norm(payload.langue || \u0027fr\u0027) || \u0027fr\u0027,\n        Contexte_Extrait: contexte ? contexte.slice(0, 1000) : \u0027\u0027,\n        Date_Saisine_T0: $json.timestamp_t0 || payload.timestamp_t0 || new Date().toISOString(),\n        Statut_Mandat: isFreeOrPack ? \u0027Saisine_Recue\u0027 : \u0027Attente_Paiement\u0027,\n        Statut_Sequestre: palierCode === \u0027Palier_1_Decouverte\u0027 ? \u0027Non_Requis\u0027 : (isFreeOrPack ? \u0027Pack_Actif\u0027 : \u0027Attente_Paiement\u0027),\n        Operateur_Paiement: palierCode === \u0027Palier_1_Decouverte\u0027 ? \u0027Offert_Palier_1\u0027 : \u0027\u0027,\n        Empreinte_SHA256: $json.empreinte_sha256 || $json.sha256_hash || $json.hash || \u0027\u0027\n      }\n    };\n  })()\n}}",
