                  {
                      "parameters":  {
                                         "jsCode":  "// Calcul SHA-256 autonome compatible sandbox n8n (Node crypto + fallback JS pur)\nfunction computeSha256(str) {\n  try {\n    const nodeCrypto = require(\u0027crypto\u0027);\n    return nodeCrypto.createHash(\u0027sha256\u0027).update(str, \u0027utf8\u0027).digest(\u0027hex\u0027);\n  } catch (e) {\n    const utf8 = unescape(encodeURIComponent(str));\n    const rightRotate = (v, a) =\u003e (v \u003e\u003e\u003e a) | (v \u003c\u003c (32 - a));\n    const maxWord = Math.pow(2, 32);\n    const words = [];\n    const hash = [];\n    const k = [];\n    const isComp = {};\n    const bitLen = utf8.length * 8;\n    let primeCount = 0;\n    let hex = \u0027\u0027;\n\n    for (let cand = 2; primeCount \u003c 64; cand++) {\n      if (!isComp[cand]) {\n        for (let i = 0; i \u003c 313; i += cand) {\n          isComp[i] = cand;\n        }\n        hash[primeCount] = (Math.pow(cand, 0.5) * maxWord) | 0;\n        k[primeCount++] = (Math.pow(cand, 1 / 3) * maxWord) | 0;\n      }\n    }\n\n    let padded = utf8 + \u0027\\x80\u0027;\n    while ((padded.length % 64) - 56) {\n      padded += \u0027\\x00\u0027;\n    }\n    for (let i = 0; i \u003c padded.length; i++) {\n      words[i \u003e\u003e 2] |= padded.charCodeAt(i) \u003c\u003c (((3 - i) % 4) * 8);\n    }\n    words[words.length] = (bitLen / maxWord) | 0;\n    words[words.length] = bitLen;\n\n    for (let j = 0; j \u003c words.length; ) {\n      const w = words.slice(j, (j += 16));\n      const oldHash = hash.slice(0);\n\n      for (let i = 0; i \u003c 64; i++) {\n        const w15 = w[i - 15];\n        const w2 = w[i - 2];\n        const a = hash[0];\n        const e = hash[4];\n\n        const t1 =\n          hash[7] +\n          (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25)) +\n          ((e \u0026 hash[5]) ^ (~e \u0026 hash[6])) +\n          k[i] +\n          (w[i] =\n            i \u003c 16\n              ? w[i]\n              : (w[i - 16] +\n                  (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 \u003e\u003e\u003e 3)) +\n                  w[i - 7] +\n                  (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 \u003e\u003e\u003e 10))) |\n                0);\n\n        const t2 =\n          (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22)) +\n          ((a \u0026 hash[1]) ^ (a \u0026 hash[2]) ^ (hash[1] \u0026 hash[2]));\n\n        hash.unshift((t1 + t2) | 0);\n        hash.pop();\n        hash[4] = (hash[4] + t1) | 0;\n      }\n\n      for (let i = 0; i \u003c 8; i++) {\n        hash[i] = (hash[i] + oldHash[i]) | 0;\n      }\n    }\n\n    for (let i = 0; i \u003c 8; i++) {\n      for (let j = 3; j + 1; j--) {\n        const b = (hash[i] \u003e\u003e (j * 8)) \u0026 255;\n        hex += (b \u003c 16 ? \u00270\u0027 : \u0027\u0027) + b.toString(16);\n      }\n    }\n    return hex;\n  }\n}\n\ntry {\n  const item = $input.first();\n  const inputData = item.json || {};\n  const envelope = inputData.mission || inputData;\n  const missionPayload = envelope.body || envelope;\n\n  // Intégration éventuelle des pièces jointes binaires\n  const binaryParts = [];\n  for (const [key, file] of Object.entries(item.binary || {})) {\n    const data = await this.helpers.getBinaryDataBuffer(0, key);\n    binaryParts.push(`${key}:${file.fileName || \u0027\u0027}:${data.toString(\u0027base64\u0027)}`);\n  }\n\n  const canonicalPayload =\n    JSON.stringify(missionPayload) +\n    (binaryParts.length ? \u0027\\n\u0027 + binaryParts.join(\u0027\\n\u0027) : \u0027\u0027);\n\n  const sha256Hash = computeSha256(canonicalPayload);\n  const timestampT0 = missionPayload.timestamp_t0 || new Date().toISOString();\n\n  // Conversion en 32 octets bruts pour le serveur calendrier OpenTimestamps (ots_digest)\n  const rawDigestBytes = new Uint8Array(\n    sha256Hash.match(/.{1,2}/g).map((byte) =\u003e parseInt(byte, 16))\n  );\n  const otsBinary = await this.helpers.prepareBinaryData(\n    Buffer.from(rawDigestBytes),\n    \u0027ots_digest.bin\u0027,\n    \u0027application/octet-stream\u0027\n  );\n\n  return [\n    {\n      json: {\n        ...inputData,\n        sha256: sha256Hash,\n        sha256_hash: sha256Hash,\n        hash: sha256Hash,\n        hashHex: sha256Hash,\n        empreinte_sha256: sha256Hash,\n        contrat_hash_ref: sha256Hash,\n        canonical_payload: canonicalPayload,\n        timestamp_t0: timestampT0\n      },\n      binary: {\n        ots_digest: otsBinary\n      }\n    }\n  ];\n} catch (err) {\n  throw new Error(`Calcul SHA-256 de la saisine impossible : ${err.message}`);\n}"
                                     },
