    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const item = $input.first();\n  const envelope = item.json.mission || item.json;\n  const mission = envelope.body || envelope;\n  const binaryParts = [];\n  for (const [key, file] of Object.entries(item.binary || {})) {\n    const data = await this.helpers.getBinaryDataBuffer(0, key);\n    binaryParts.push(`${key}:${file.fileName || ''}:${data.toString('base64')}`);\n  }\n  const canonicalPayload = JSON.stringify(mission) + binaryParts.join('\\n');\n  const digest = await globalThis.crypto.subtle.digest('SHA-256', new TextEncoder().encode(canonicalPayload));\n  const digestBytes = new Uint8Array(digest);\n  const hash = Array.from(digestBytes, byte => byte.toString(16).padStart(2, '0')).join('');\n  const otsDigest = await this.helpers.prepareBinaryData(Buffer.from(digestBytes), 'sha256.bin', 'application/octet-stream');\n  return [{ json: { ...mission, sha256_hash: hash, date_analyse_utc: mission.date_analyse_utc || new Date().toISOString(), _binary_keys: Object.keys(item.binary || {}) }, binary: { ...(item.binary || {}), ots_digest: otsDigest } }];\n} catch (err) { throw new Error(`Calcul SHA-256 de la saisine impossible: ${err.message}`); }"
      },
