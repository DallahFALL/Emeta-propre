                  {
                      "id":  "99000000-0000-4000-8000-000000000002",
                      "name":  "Calibrer Profils & Grades",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -400,
                                       120
                                   ],
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "const raw = $input.first().json || {};\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst list = Array.isArray(body.candidats) ? body.candidats : (Array.isArray(body) ? body : [body]);\n\nconst norm = (v) => String(v || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n\nconst mapSector = (s) => {\n  const n = norm(s);\n  if (/ener|mine|solair|petrol/.test(n)) return 'energy';\n  if (/banq|fintech|assur|monet|finance/.test(n)) return 'banking';\n  if (/logist|port|supply|transport/.test(n)) return 'logistics';\n  if (/sant|pharma|bio|medic/.test(n)) return 'health';\n  if (/telecom|cloud|cyber|numer|it/.test(n)) return 'telecom';\n  if (/btp|immob|foncier|construc/.test(n)) return 'property';\n  if (/industr|transfo|usine/.test(n)) return 'manufacturing';\n  if (/public|etat|minist|ppp|diplom/.test(n)) return 'public';\n  if (/retail|distrib|negoce|commerc/.test(n)) return 'retail';\n  return 'agro';\n};\n\nconst out = [];\nfor (const c of list) {\n  const email = String(c.email || '').trim().toLowerCase();\n  const nom = String(c.nom_complet || c.nom || '').trim();\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || !nom) continue;\n\n  const exp = Number(c.annees_experience || c.experience || 5);\n  const titre = String(c.titre || c.poste || '').trim();\n  const tNorm = norm(titre);\n\n  let grade = 'Grade_I_Praticien';\n  let gradeLabel = 'Praticien Opérationnel';\n  if (exp >= 18 || /directeur general|\\bdg\\b|ceo|partner|associe|ancien ministre|gouverneur|bceao/.test(tNorm)) {\n    grade = 'Grade_III_Executive_Fellow';\n    gradeLabel = 'Executive Fellow';\n  } else if (exp >= 10 || /directeur|daf|cfo|coo|cto|ingénieur en chef|ingenieur en chef/.test(tNorm)) {\n    grade = 'Grade_II_Senior';\n    gradeLabel = 'Senior Advisor';\n  }\n\n  const secteur = mapSector(c.secteur || c.domaine);\n  const sectorLabelMap = {\"property\":\"Immobilier / BTP \& Grands Travaux\",\"agro\":\"Agro-industrie \& Souveraineté Alimentaire\",\"energy\":\"Énergie / Mines \& Transition\",\"banking\":\"Banque / FinTech \& Assurance\",\"logistics\":\"Logistique / Ports \& Chaîne d\'approvisionnement\",\"health\":\"Santé - Pharma \& Biotechnologies\",\"telecom\":\"Télécoms / Cloud \& Infrastructures\",\"manufacturing\":\"Industrie manufacturière \& Transformation\",\"public\":\"Secteur public \& parapublic\",\"retail\":\"Distribution / Retail \& Négoce\"};\n  const secteur_label = sectorLabelMap[secteur] || 'Agro-industrie & Souveraineté alimentaire';\n  const cooptCode = 'COOPT-' + Math.floor(100000 + Math.random() * 900000);\n  const inviteUrl = `https://e-metalabs.com/expert.html?secteur=${encodeURIComponent(secteur)}&grade=${encodeURIComponent(grade)}&email=${encodeURIComponent(email)}`;\n\n  out.push({\n    json: {\n      nom_complet: nom,\n      email,\n      whatsapp: String(c.whatsapp || c.telephone || '').trim(),\n      linkedin: String(c.linkedin || '').trim(),\n      secteur_code: secteur, secteur_label,\n      annees_experience: exp,\n      grade_accreditation: grade,\n      grade_label: gradeLabel,\n      source_sourcing: String(c.source || 'OSINT_Zimbra').trim(),\n      code_parrain_attribue: cooptCode,\n      parrain_ref: String(c.code_parrain || '').trim().toUpperCase(),\n      invite_url: inviteUrl\n    }\n  });\n}\n\nif (!out.length) throw new Error('Aucun profil valide (nom + email requis).');\nreturn out;"
                                     }
                  },
