                      "name":  "Valider Payload Recette",
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first().json || {};\nconst body = raw.body \u0026\u0026 typeof raw.body === \u0027object\u0027 ? raw.body : raw;\nconst ref = String(body.ref || body.reference || body.mission_ref || \u0027\u0027).trim().toUpperCase();\nif (!/^MIS-20\\d{2}-\\d{3,6}$/.test(ref)) throw new Error(\u0027Référence mission invalide.\u0027);\nreturn [{ json: { reference: ref, lang: String(body.lang || \u0027fr\u0027).trim() } }];",
                                         "mode":  "runOnceForAllItems"
                                     },
                      "type":  "n8n-nodes-base.code",
