                  {
                      "id":  "88000000-0000-4000-8000-000000000008",
                      "name":  "Préparer Libération Expert \u0026 Mail",
                      "parameters":  {
                                         "jsCode":  "const calc = $(\u0027Calculer Clôture \u0026 État de Paiement\u0027).first().json;\nconst resp = $input.first().json || {};\nconst list = resp.records || resp.list || [];\n\nconst rec = list.find((r) =\u003e Number(r.id || r.id_fields?.Id || r.fields?.Id) === calc.expert_id) || {};\nconst ef = rec.fields || rec;\nconst expertNom = String(ef.Nom_Complet || calc.expert_assigne || \u0027Expert Accrédité\u0027).trim();\nconst expertEmail = String(ef.Email_Pro || ef.Email || \u0027\u0027).trim();\nconst nextActives = Math.max(0, Number(ef.Missions_Actives || 1) - 1);\nconst nextSla = Math.min(100, Number(ef.Note_Fiabilite_SLA || 95) + 1);\n\nconst fmt = (n) =\u003e Number(n || 0).toLocaleString(\u0027fr-FR\u0027);\nconst toEmails = expertEmail ? `${expertEmail}, contact@e-metalabs.com` : \u0027contact@e-metalabs.com\u0027;\n\nconst bordereauHtml = `\u003cdiv style=\"font-family:Georgia,serif;background:#0a192f;color:#f8fafc;padding:32px;border-radius:16px;max-width:640px;margin:auto;border:1px solid #d4af37\"\u003e\n  \u003cp style=\"color:#d4af37;font-family:monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:0\"\u003eE-META LABS SASU • ÉTAT DE PAIEMENT \u0026amp; REVERSEMENT\u003c/p\u003e\n  \u003ch2 style=\"color:#ffffff;margin:10px 0 6px\"\u003eBordereau ${calc.bordereau_ref}\u003c/h2\u003e\n  \u003cp style=\"color:#94a3b8;font-family:monospace;font-size:12px;margin:0 0 20px\"\u003eMandat : ${calc.reference_mission} • Client : ${calc.client_title} • Clôturé le ${calc.closed_at}\u003c/p\u003e\n  \u003cp style=\"color:#cbd5e1;font-size:14px;line-height:1.6\"\u003eBonjour \u003cstrong\u003e${expertNom}\u003c/strong\u003e,\u003cbr\u003eLa recette client du mandat \u003cstrong\u003e${calc.reference_mission}\u003c/strong\u003e a été validée. Les fonds consignés en séquestre sont libérés selon la répartition contractuelle :\u003c/p\u003e\n  \u003ctable style=\"width:100%;border-collapse:collapse;margin:20px 0;font-family:monospace;font-size:13px\"\u003e\n    \u003ctr style=\"border-bottom:1px solid #1e293b\"\u003e\u003ctd style=\"padding:10px;color:#94a3b8\"\u003eMontant brut séquestre (100 %)\u003c/td\u003e\u003ctd style=\"padding:10px;text-align:right;color:#ffffff\"\u003e${fmt(calc.montant_total)} ${calc.devise}\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr style=\"border-bottom:1px solid #1e293b\"\u003e\u003ctd style=\"padding:10px;color:#94a3b8\"\u003eCommission E-META LABS SASU (15 % HT)\u003c/td\u003e\u003ctd style=\"padding:10px;text-align:right;color:#f87171\"\u003e- ${fmt(calc.commission_emeta)} ${calc.devise}\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr style=\"background:rgba(212,175,55,0.12)\"\u003e\u003ctd style=\"padding:12px;color:#d4af37;font-weight:bold\"\u003eNET À REVERSER EXPERT (85 %)\u003c/td\u003e\u003ctd style=\"padding:12px;text-align:right;color:#34d399;font-weight:bold;font-size:15px\"\u003e${fmt(calc.quote_part_expert)} ${calc.devise}\u003c/td\u003e\u003c/tr\u003e\n  \u003c/table\u003e\n  \u003cp style=\"color:#94a3b8;font-size:11px;font-family:monospace;word-break:break-all\"\u003eEmpreinte Contrat SHA-256 : ${calc.contrat_hash || \u0027Scellée au registre\u0027}\u003cbr\u003eVotre disponibilité a été rétablie (Score SLA : ${nextSla}/100).\u003c/p\u003e\n  \u003cp style=\"color:#64748b;font-size:11px;border-top:1px solid #1e293b;padding-top:12px;margin-top:18px\"\u003eE-META LABS SASU • RCCM SN STL 2026 B768 • NINEA 012887553 • Rosso, Sénégal\u003c/p\u003e\n\u003c/div\u003e`;\n\nreturn [{\n  json: {\n    expert_id: calc.expert_id,\n    expert_nom: expertNom,\n    to_emails: toEmails,\n    subject: `État de Paiement ${calc.bordereau_ref} — Mandat ${calc.reference_mission} (${fmt(calc.quote_part_expert)} ${calc.devise})`,\n    bordereau_html: bordereauHtml,\n    expert_patch: calc.expert_id \u003e 0 ? [{\n      id: calc.expert_id,\n      fields: {\n        Statut_Disponibilite: \u0027Disponible\u0027,\n        Missions_Actives: nextActives,\n        Note_Fiabilite_SLA: nextSla\n      }\n    }] : []\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
