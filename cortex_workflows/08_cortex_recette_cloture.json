                  {
                      "id":  "88000000-0000-4000-8000-000000000004",
                      "name":  "Préparer Clôture \u0026 Libération Séquestre",
                      "parameters":  {
                                         "jsCode":  "const ref = $(\u0027Valider Payload Recette\u0027).first().json.reference;\nconst resp = $input.first().json || {};\nconst rec = (resp.records || resp.list || [])[0];\nif (!rec) throw new Error(`Dossier ${ref} introuvable dans Registre_Missions.`);\n\nconst f = rec.fields || rec;\nconst recordId = Number(rec.id || rec.id_fields?.Id || f.Id);\nconst nowIso = new Date().toISOString();\n\nconst expertMatch = String(f.Expert_Assigne || \u0027\u0027).match(/#(\\d+)/);\nconst expertId = expertMatch ? Number(expertMatch[1]) : null;\nconst hasEscrow = /consigne/i.test(String(f.Statut_Sequestre || \u0027\u0027));\n\nconst missionPatch = [{\n  id: recordId,\n  fields: {\n    Statut_Mandat: \u0027Cloture\u0027,\n    Statut_Sequestre: hasEscrow ? \u0027Libere\u0027 : (f.Statut_Sequestre || \u0027Non_Requis\u0027),\n    Date_Recette_UTC: nowIso\n  }\n}];\n\nconst expertPatch = expertId\n  ? [{ id: expertId, fields: { Statut: \u0027Disponible\u0027 } }]\n  : [];\n\nconst telegramSummary = `✅ RECETTE CLIENT \u0026 CLÔTURE — ${ref}\\n• Client : ${f.Title || ref}\\n• Palier : ${f.Palier_Mandat || \u0027Mandat Certifié\u0027}\\n• Séquestre : ${hasEscrow ? `LIBÉRÉ (85% Partenaire = ${f.Quote_Part_Expert || 0} ${f.Devise || \u0027\u0027} | 15% Commission E-META = ${f.Commission_Emeta || 0} ${f.Devise || \u0027\u0027})` : \u0027Non requis / Offert\u0027}\\n• Partenaire : ${f.Expert_Assigne || \u0027Audit IA\u0027}\\n• Clôturé le : ${nowIso}`;\n\nreturn [{\n  json: {\n    reference: ref,\n    has_expert: Boolean(expertId),\n    mission_patch: missionPatch,\n    expert_patch: expertPatch,\n    telegram_summary: telegramSummary,\n    closed_at: nowIso\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
                      "type":  "n8n-nodes-base.code",
