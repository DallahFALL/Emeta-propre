                      "id":  "88000000-0000-4000-8000-000000000008",
                      "name":  "Préparer Libération Expert & Mail",
                      "parameters":  {
                                         "jsCode":  "const calc = $('Calculer Clôture & État de Paiement').first().json;\nconst resp = $input.first().json || {};\nconst list = resp.records || resp.list || [];\n\nconst rec = list.find((r) => Number(r.id || r.id_fields?.Id || r.fields?.Id) === calc.expert_id) || {};\nconst ef = rec.fields || rec;\nconst expertNom = String(ef.Nom_Complet || calc.expert_assigne || 'Expert Accrédité').trim();\nconst expertEmail = String(ef.Email_Pro || ef.Email || '').trim();\nconst nextActives = Math.max(0, Number(ef.Missions_Actives || 1) - 1);\nconst nextSla = Math.min(100, Number(ef.Note_Fiabilite_SLA || 95) + 1);\n\nconst fmt = (n) => Number(n || 0).toLocaleString('fr-FR');\nconst toEmails = expertEmail ? `${expertEmail}, contact@e-metalabs.com` : 'contact@e-metalabs.com';\n\nconst bordereauHtml = `<div style=\"font-family:Georgia,serif;background:#0a192f;color:#f8fafc;padding:32px;border-radius:16px;max-width:640px;margin:auto;border:1px solid #d4af37\">\n  <p style=\"color:#d4af37;font-family:monospace;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:0\">E-META LABS SASU • ÉTAT DE PAIEMENT &amp; REVERSEMENT</p>\n  <h2 style=\"color:#ffffff;margin:10px 0 6px\">Bordereau ${calc.bordereau_ref}</h2>\n  <p style=\"color:#94a3b8;font-family:monospace;font-size:12px;margin:0 0 20px\">Mandat : ${calc.reference_mission} • Client : ${calc.client_title} • Clôturé le ${calc.closed_at}</p>\n  <p style=\"color:#cbd5e1;font-size:14px;line-height:1.6\">Bonjour <strong>${expertNom}</strong>,<br>La recette client du mandat <strong>${calc.reference_mission}</strong> a été validée. Les fonds consignés en séquestre sont libérés selon la répartition contractuelle :</p>\n  <table style=\"width:100%;border-collapse:collapse;margin:20px 0;font-family:monospace;font-size:13px\">\n    <tr style=\"border-bottom:1px solid #1e293b\"><td style=\"padding:10px;color:#94a3b8\">Montant brut séquestre (100 %)</td><td style=\"padding:10px;text-align:right;color:#ffffff\">${fmt(calc.montant_total)} ${calc.devise}</td></tr>\n    <tr style=\"border-bottom:1px solid #1e293b\"><td style=\"padding:10px;color:#94a3b8\">Commission E-META LABS SASU (15 % HT)</td><td style=\"padding:10px;text-align:right;color:#f87171\">- ${fmt(calc.commission_emeta)} ${calc.devise}</td></tr>\n    <tr style=\"background:rgba(212,175,55,0.12)\"><td style=\"padding:12px;color:#d4af37;font-weight:bold\">NET À REVERSER EXPERT (85 %)</td><td style=\"padding:12px;text-align:right;color:#34d399;font-weight:bold;font-size:15px\">${fmt(calc.quote_part_expert)} ${calc.devise}</td></tr>\n  </table>\n  <p style=\"color:#94a3b8;font-size:11px;font-family:monospace;word-break:break-all\">Empreinte Contrat SHA-256 : ${calc.contrat_hash || 'Scellée au registre'}<br>Votre disponibilité a été rétablie (Score SLA : ${nextSla}/100).</p>\n  <p style=\"color:#64748b;font-size:11px;border-top:1px solid #1e293b;padding-top:12px;margin-top:18px\">E-META LABS SASU • RCCM SN STL 2026 B768 • NINEA 012887553 • Rosso, Sénégal</p>\n</div>`;\n\nreturn [{\n  json: {\n    expert_id: calc.expert_id,\n    expert_nom: expertNom,\n    to_emails: toEmails,\n    subject: `État de Paiement ${calc.bordereau_ref} — Mandat ${calc.reference_mission} (${fmt(calc.quote_part_expert)} ${calc.devise})`,\n    bordereau_html: bordereauHtml,\n    expert_patch: calc.expert_id > 0 ? [{\n      id: calc.expert_id,\n      fields: {\n        Statut_Disponibilite: 'Disponible',\n        \n        Note_Fiabilite_SLA: nextSla\n      }\n    }] : []\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
