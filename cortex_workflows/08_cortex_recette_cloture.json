                  {
                      "id":  "88000000-0000-4000-8000-000000000003",
                      "name":  "Calculer Clôture & État de Paiement",
                      "parameters":  {
                                         "jsCode":  "const raw = $input.first().json || {};\nconst records = raw.records || raw.list || (Array.isArray(raw) ? raw : []);\nconst wh = $('Webhook Recette Clôture').first().json || {};\nconst body = wh.body && typeof wh.body === 'object' ? wh.body : wh;\nconst targetRef = String(body.ref || body.reference_mission || '').trim().toUpperCase();\n\nconst row = records.find((r) => {\n  const f = r.fields || r;\n  return String(f.Mission_Ref || '').trim().toUpperCase() === targetRef;\n}) || records[0];\n\nif (!row) throw new Error(`Mission ${targetRef || 'inconnue'} introuvable dans Registre_Missions.`);\n\nconst f = row.fields || row;\nconst recordId = Number(row.id || row.id_fields?.Id || f.Id);\nconst resolvedRef = String(f.Mission_Ref || targetRef).trim().toUpperCase();\nconst expertAssigne = String(f.Expert_Assigne || '').trim();\nconst idMatch = expertAssigne.match(/#(\\d+)/);\nconst expertId = idMatch ? Number(idMatch[1]) : 0;\n\nconst montantTotal = Number(f.Montant_Total || f.Montant || f.Montant_FCFA || 0);\nconst devise = String(f.Devise || 'XOF').trim().toUpperCase();\nconst quotePartExpert = Number(f.Quote_Part_Expert || Math.round(montantTotal * 0.85 * 100) / 100);\nconst commissionEmeta = Number(f.Commission_Emeta || Math.round(montantTotal * 0.15 * 100) / 100);\nconst hasExpert = Boolean(expertId > 0 || expertAssigne);\nconst bordereauRef = 'BORD-' + resolvedRef.replace(/^MIS-/i, '');\nconst closedAt = new Date().toISOString();\n\nconst missionPatch = [{\n  id: recordId,\n  fields: {\n    Statut_Mandat: 'Cloture_Valide',\n    Statut_Sequestre: hasExpert ? 'Libere_Expert' : (f.Statut_Sequestre || 'Non_Requis')\n  }\n}];\n\nreturn [{\n  json: {\n    record_id: recordId,\n    reference_mission: resolvedRef,\n    client_title: String(f.Title || resolvedRef).trim(),\n    palier_mandat: String(f.Palier_Mandat || 'Palier_2_Certifie'),\n    secteur_code: String(f.Secteur_Code || 'agro'),\n    expert_assigne: expertAssigne,\n    expert_id: expertId,\n    has_expert: hasExpert,\n    bordereau_ref: bordereauRef,\n    montant_total: montantTotal,\n    quote_part_expert: quotePartExpert,\n    commission_emeta: commissionEmeta,\n    devise,\n    contrat_hash: String(f.Contrat_Hash_Ref || f.Empreinte_SHA256 || '').trim(),\n    closed_at: closedAt,\n    mission_patch: missionPatch\n  }\n}];",
                                         "mode":  "runOnceForAllItems"
                                     },
