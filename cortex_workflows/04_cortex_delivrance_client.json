                  {
                      "parameters":  {
                                         "jsCode":  "try {\n  const response = $input.first().json || {};\n  const records = response.records || response.list || (Array.isArray(response) ? response : []);\n\n  const parseIfString = (val) =\u003e {\n    if (typeof val === \u0027string\u0027) {\n      try {\n        const parsed = JSON.parse(val);\n        return (parsed \u0026\u0026 typeof parsed === \u0027object\u0027) ? parsed : {};\n      } catch {\n        return {};\n      }\n    }\n    return (val \u0026\u0026 typeof val === \u0027object\u0027) ? val : {};\n  };\n\n  const initData = parseIfString($(\u0027Initialisation standardisée\u0027).first()?.json);\n  const webhookRaw = parseIfString($(\u0027Webhook Délivrance\u0027).first()?.json);\n  const webhookBody = parseIfString(webhookRaw.body || webhookRaw);\n  const initMission = parseIfString(initData.mission);\n  const initMissionBody = parseIfString(initMission.body || initMission);\n  const canonicalPayload = parseIfString(\n    webhookBody.canonical_payload || initMissionBody.canonical_payload || initData.canonical_payload\n  );\n\n  const mission = {\n    ...canonicalPayload,\n    ...webhookBody,\n    ...parseIfString(initData.body),\n    ...initMission,\n    ...initMissionBody\n  };\n\n  // Recherche directe puis extraction récursive (y compris dans les chaînes JSON ou textes)\n  let targetRef = String(\n    mission.reference_mission ||\n    mission.mission_ref ||\n    mission.Mission_Ref ||\n    mission.reference ||\n    mission.Code_Mission ||\n    mission.code_mission ||\n    mission.ref ||\n    \u0027\u0027\n  ).trim();\n\n  if (!/^MIS-\\d{4}-\\d+$/i.test(targetRef)) {\n    const findMissionCode = (obj, depth = 0) =\u003e {\n      if (obj === null || obj === undefined || depth \u003e 6) return \u0027\u0027;\n      if (typeof obj === \u0027string\u0027) {\n        const match = obj.match(/\\bMIS-\\d{4}-\\d+\\b/i);\n        return match ? match[0].toUpperCase() : \u0027\u0027;\n      }\n      if (typeof obj === \u0027object\u0027) {\n        for (const val of Object.values(obj)) {\n          const found = findMissionCode(val, depth + 1);\n          if (found) return found;\n        }\n      }\n      return \u0027\u0027;\n    };\n    targetRef = findMissionCode({ mission, initData, webhookRaw });\n  } else {\n    targetRef = targetRef.toUpperCase();\n  }\n\n  if (records.length === 0) {\n    throw new Error(\n      `NocoDB a renvoyé 0 enregistrement pour la référence \u0027${targetRef || \u0027non trouvée\u0027}\u0027. Vérifiez le filtre \u0027where\u0027 (sans apostrophes) et la table mv1cb6xm00g6rf5 dans \u0027Rechercher mission à délivrer\u0027.`\n    );\n  }\n\n  let row = null;\n  if (targetRef) {\n    row = records.find((candidate) =\u003e {\n      const f = candidate.fields || candidate;\n      const candidateRef =\n        f.Mission_Ref ||\n        f.Code_Mission ||\n        f.Reference_Mission ||\n        f.reference_mission ||\n        f.Title ||\n        \u0027\u0027;\n      return String(candidateRef).trim().toUpperCase() === targetRef;\n    });\n  } else if (records.length === 1) {\n    row = records[0];\n  }\n\n  if (!row) {\n    throw new Error(`Mission (${targetRef || \u0027sans référence\u0027}) absente des ${records.length} lignes retournées par NocoDB.`);\n  }\n\n  const f = row.fields || row;\n  const resolvedRef = String(\n    targetRef ||\n    f.Mission_Ref ||\n    f.Code_Mission ||\n    f.Reference_Mission ||\n    f.reference_mission ||\n    f.Title ||\n    \u0027\u0027\n  ).trim().toUpperCase();\n\n  const recordId = row.id || row.id_fields?.Id || f.Id || f.id;\n  if (!Number.isSafeInteger(Number(recordId))) {\n    throw new Error(\u0027ID numérique NocoDB manquant ou invalide.\u0027);\n  }\n\n  const amountValue = mission.montant_eur ?? mission.montant ?? mission.amount ?? f.Montant ?? f.Montant_FCFA ?? 0;\n  const amount = Number(amountValue);\n  if (!Number.isFinite(amount) || amount \u003c 0) {\n    throw new Error(\u0027Montant de séquestre manquant ou invalide.\u0027);\n  }\n\n  const rawPhone =\n    mission.whatsapp ||\n    mission.telephone ||\n    mission.phone ||\n    f.WhatsApp ||\n    f.Telephone ||\n    \u0027\u0027;\n  const phone = String(rawPhone).replace(/\\D/g, \u0027\u0027);\n  if (!/^\\d{8,15}$/.test(phone)) {\n    throw new Error(\u0027Numéro WhatsApp/téléphone au format chiffres seuls (8 à 15 chiffres) manquant ou invalide.\u0027);\n  }\n\n  const webViewLink =\n    mission.webViewLink ||\n    mission.pdf_url ||\n    mission.tracker_url ||\n    f.Rapport_URL ||\n    `https://e-metalabs.com/tracker.html?ref=${encodeURIComponent(resolvedRef)}`;\n\n  const clientEmail = String(mission.email || mission.email_client || f.Email || f.Email_Client || f.Email_Pro || \u0027\u0027).trim();\n  const sha256Hash = String(\n    mission.empreinte_sha256 ||\n    mission.sha256_hash ||\n    mission.hash ||\n    f.Empreinte_SHA256 ||\n    f.Contrat_Hash_Ref ||\n    \u0027\u0027\n  ).trim();\n\n  // Adaptez \u0027Livre_Client\u0027 si votre option Single select dans Statut_Mandat porte un autre nom exact\n  const patchFields = {\n    Statut_Mandat: \u0027Livre_Client\u0027\n  };\n  if (sha256Hash) {\n    patchFields.Empreinte_SHA256 = sha256Hash;\n  }\n\n  return [\n    {\n      json: {\n        ...mission,\n        reference: resolvedRef,\n        email: clientEmail,\n        email_client: clientEmail,\n        reference_mission: resolvedRef,\n        telephone: phone,\n        whatsapp: phone,\n        record_id: Number(recordId),\n        sha256_hash: sha256Hash,\n        empreinte_sha256: sha256Hash,\n        patch: {\n          id: Number(recordId),\n          fields: patchFields\n        },\n        escrow: {\n          devise: mission.devise || mission.currency || f.Devise || \u0027EUR\u0027,\n          montant_total: amount,\n          part_cabinet: Math.round(amount * 0.15 * 100) / 100,\n          part_expert: Math.round(amount * 0.85 * 100) / 100,\n          expert_release_at: new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toISOString()\n        },\n        webViewLink\n      }\n    }\n  ];\n} catch (err) {\n  throw new Error(`Mapping délivrance impossible: ${err.message}`);\n}"
                                     },
