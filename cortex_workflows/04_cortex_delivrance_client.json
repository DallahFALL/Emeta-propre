                                         "jsCode":  "const input = $input.first().json;\nconst pdfBase64 = String(input.pdf_base64 || \u0027\u0027).trim();\nif (!pdfBase64) {\n  throw new Error(\u0027Le contenu PDF encodé en base64 est manquant.\u0027);\n}\nconst ref = String(input.reference_mission || input.reference || input.mission_ref || \u0027rapport\u0027).trim();\nconst token16 = Array.from({ length: 16 }, () =\u003e Math.floor(Math.random() * 16).toString(16)).join(\u0027\u0027);\nconst fileName = `${ref}-${token16}.pdf`;\nconst rapportUrl = `https://rapports.e-metalabs.com/${fileName}`;\nconst binaryData = await this.helpers.prepareBinaryData(Buffer.from(pdfBase64, \u0027base64\u0027), fileName, \u0027application/pdf\u0027);\nconst patch = {\n  ...input.patch,\n  fields: {\n    ...input.patch?.fields,\n    Rapport_URL: rapportUrl\n  }\n};\nreturn [{\n  json: {\n    ...input,\n    rapport_file_path: `/home/node/.n8n-files/rapports/${fileName}`,\n    rapport_url: rapportUrl,\n    webViewLink: rapportUrl,\n    patch\n  },\n  binary: { pdf_file: binaryData }\n}];"
