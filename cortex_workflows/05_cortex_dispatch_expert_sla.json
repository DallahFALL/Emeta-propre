      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const response = $input.first().json;\n  const records = response.records || response.list || (Array.isArray(response) ? response : []);\n  const available = records.map(row => { const f = row.fields || row; const recordId = row.id || row.id_fields?.Id || f.Id || f.id; return { ...f, recordId: Number(recordId) }; }).filter(expert => Number.isSafeInteger(expert.recordId) && !/indisponible|suspendu|delai_expire/i.test(String(expert.Statut || ''))).sort((a, b) => Number(a.Priorite || a.Score || 9999) - Number(b.Priorite || b.Score || 9999));\n  if (available.length < 2) throw new Error('Deux profils experts disponibles sont requis pour la cascade SLA.');\n  if (!available[0].Telegram_Chat_ID || !available[1].Telegram_Chat_ID) throw new Error('Telegram_Chat_ID doit être renseigné pour les deux premiers profils.');\n  const mission = $('Initialisation standardisée').first().json.mission.body || $('Initialisation standardisée').first().json.mission;\n  const tokenBytes = new Uint8Array(32);\n  globalThis.crypto.getRandomValues(tokenBytes);\n  const token = Array.from(tokenBytes, byte => byte.toString(16).padStart(2, '0')).join('');\n  const digest = await globalThis.crypto.subtle.digest('SHA-256', new TextEncoder().encode(token));\n  const token_hash = Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');\n  if (!/^MIS-2026-\\d{4}$/.test(mission.reference_mission || mission.reference || '')) throw new Error('Référence mission MIS-2026-XXXX invalide.');\n  return [{ json: { ...mission, reference_mission: mission.reference_mission || mission.reference, expert1: available[0], expert2: available[1], token, token_hash, expires_at: new Date(Date.now() + 120 * 60 * 1000).toISOString() } }];\n} catch (err) { throw new Error(`Sélection des experts impossible: ${err.message}`); }"
