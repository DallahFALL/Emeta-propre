                  {
                      "parameters":  {
                                         "jsCode":  "const ref = String($(\u0027Valider Paramètre Ref\u0027).first().json.mission_ref || \u0027\u0027).trim().toUpperCase();\nconst inputData = $input.first().json || {};\nconst records = Array.isArray(inputData.records)\n  ? inputData.records\n  : (Array.isArray(inputData.list) ? inputData.list : []);\n\nif (records.length === 0) {\n  return [\n    {\n      json: {\n        found: false,\n        ok: false,\n        statusCode: 404,\n        payload: {\n          found: false,\n          reference: ref,\n          error: \u0027Dossier introuvable\u0027\n        }\n      }\n    }\n  ];\n}\n\nconst record = records[0];\nconst f = record.fields \u0026\u0026 typeof record.fields === \u0027object\u0027 ? record.fields : record;\n\nconst normalizeKey = (val) =\u003e\n  String(val || \u0027\u0027)\n    .normalize(\u0027NFD\u0027)\n    .replace(/[\\u0300-\\u036f]/g, \u0027\u0027)\n    .toLowerCase()\n    .trim();\n\nconst statutBrut = String(f.Statut_Mandat || f.Statut || f.Statut_Mission || \u0027Saisine_Recue\u0027).trim();\nconst sNorm = normalizeKey(statutBrut);\n\nconst palierBrut = String(f.Palier_Mandat || f.Palier || f.Option_Audit || \u0027\u0027).trim();\nconst palierKey = normalizeKey(palierBrut);\nconst isDecouverte = /decouver|palier_1|option a|p1/.test(palierKey);\n\nconst rawExpert = f.Expert_Assigne ?? f.Expert_ID ?? f.Expert_Nom ?? null;\nconst hasAssignedExpert = Array.isArray(rawExpert)\n  ? rawExpert.length \u003e 0\n  : (typeof rawExpert === \u0027object\u0027 \u0026\u0026 rawExpert !== null)\n    ? Object.keys(rawExpert).length \u003e 0\n    : (typeof rawExpert === \u0027number\u0027\n      ? rawExpert \u003e 0\n      : Boolean(String(rawExpert || \u0027\u0027).trim()));\n\nconst expertMobilise = Boolean(\n  hasAssignedExpert ||\n  f.Expert_Mobilise === true ||\n  (!isDecouverte \u0026\u0026 /affect|mobilis|assign|en mission|audit|arbitrage|livr|clotur|termin/.test(sNorm))\n);\n\nconst statutLabelMap = {\n  saisine_recue: \u0027Saisine reçue \u0026 scellée\u0027,\n  dispatch_en_cours: \u0027Dispatch expert en cours (SLA 2h)\u0027,\n  affectee: \u0027Expert senior mobilisé\u0027,\n  affecte: \u0027Expert senior mobilisé\u0027,\n  audit_en_cours: \u0027Audit \u0026 arbitrage en cours\u0027,\n  en_audit: \u0027Audit \u0026 arbitrage en cours\u0027,\n  livre: \u0027Livrable stratégique disponible\u0027,\n  livree: \u0027Livrable stratégique disponible\u0027,\n  livre_client: \u0027Livrable stratégique disponible\u0027,\n  cloture: \u0027Clôturé\u0027,\n  cloturee: \u0027Clôturé\u0027\n};\n\nconst palierLabelMap = {\n  palier_1_decouverte: \u0027Palier 1 — Découverte\u0027,\n  palier_2_certifie: \u0027Mandat Certifié\u0027,\n  palier_3_chambre: \u0027Chambre Stratégique\u0027\n};\n\nconst secteurBrut = String(f.Secteur_Code || f.Secteur || f.Secteur_Activite || \u0027\u0027).trim();\nconst secteurKey = normalizeKey(secteurBrut);\nconst secteurLabelMap = {\n  agro: \u0027Agro-industrie \u0026 Souveraineté Alimentaire\u0027,\n  energy: \u0027Énergie, Mines \u0026 Transition\u0027,\n  energie: \u0027Énergie, Mines \u0026 Transition\u0027,\n  banking: \u0027Banque, FinTech \u0026 Assurance\u0027,\n  finance: \u0027Finance \u0026 Conformité\u0027,\n  fintech: \u0027Fintech \u0026 Paiements\u0027,\n  logistics: \u0027Logistique, Ports \u0026 Supply Chain\u0027,\n  logistique: \u0027Logistique \u0026 Supply Chain\u0027,\n  health: \u0027Santé, Pharma \u0026 Bio\u0027,\n  sante: \u0027Santé \u0026 Biotech\u0027,\n  telecom: \u0027Télécoms, Cloud \u0026 Infra\u0027,\n  property: \u0027BTP, Immobilier \u0026 Foncier\u0027,\n  btp: \u0027BTP \u0026 Aménagement\u0027,\n  manufacturing: \u0027Industrie \u0026 Transformation\u0027,\n  industrie: \u0027Industrie \u0026 Chaîne Logistique\u0027,\n  public: \u0027Secteur Public \u0026 Para-public\u0027,\n  retail: \u0027Distribution, Retail \u0026 Négoce\u0027,\n  tech: \u0027Tech, IA \u0026 Souveraineté Numérique\u0027,\n  ia: \u0027Tech, IA \u0026 Souveraineté Numérique\u0027,\n  mines: \u0027Mines \u0026 Ressources\u0027\n};\n\nconst secteurAffiche = secteurKey.startsWith(\u0027code sectoriel\u0027) || !secteurBrut\n  ? \u0027Audit Stratégique\u0027\n  : (secteurLabelMap[secteurKey] || secteurBrut);\n\nlet etape = 1;\nlet libelle = \u0027Saisine enregistrée \u0026 qualifiée\u0027;\n\nif (/clotur|termin|archiv/.test(sNorm)) {\n  etape = 5;\n  libelle = \u0027Mandat clôturé \u0026 certifié\u0027;\n} else if (/livr|rapport|restitu/.test(sNorm)) {\n  etape = 4;\n  libelle = \u0027Livrable stratégique disponible\u0027;\n} else if (/audit|analyse|arbitrage|production/.test(sNorm)) {\n  etape = 3;\n  libelle = \u0027Audit \u0026 arbitrage stratégique en cours\u0027;\n} else if (/affect|mobilis|assign|en mission/.test(sNorm) || expertMobilise) {\n  etape = 2;\n  libelle = \u0027Expert senior mobilisé\u0027;\n} else if (/dispatch/.test(sNorm)) {\n  etape = 1;\n  libelle = \u0027Dispatch expert en cours (SLA 2h)\u0027;\n}\n\nconst dtoPublic = {\n  reference: String(f.Mission_Ref || f.Code_Mission || ref).trim(),\n  statut: statutLabelMap[sNorm] || statutBrut,\n  statut_brut: statutBrut,\n  etape_courante: etape,\n  etape_totale: 5,\n  libelle_etape: libelle,\n  palier: palierLabelMap[palierKey] || palierBrut || \u0027Mandat Certifié\u0027,\n  secteur: secteurAffiche,\n  expert_mobilise: expertMobilise,\n  hash: f.Empreinte_SHA256 || f.Contrat_Hash_Ref || f.Hash_SHA256 || f.Hash_OTS || null,\n  link: f.Rapport_URL || f.Lien_Livrable || f.Livrable_URL || f.webViewLink || null,\n  mise_a_jour_utc: f.UpdatedAt || f.Updated_At || f.CreatedAt || record.updated_at || record.created_at || new Date().toISOString()\n};\n\nreturn [\n  {\n    json: {\n      found: true,\n      ok: true,\n      statusCode: 200,\n      payload: dtoPublic\n    }\n  }\n];"
                                     },
