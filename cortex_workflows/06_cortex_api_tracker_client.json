                  {
                      "parameters":  {
                                         "jsCode":  "const query = $input.first().json.query || {};\nconst rawRef = String(query.ref || \u0027\u0027).trim().toUpperCase();\n\nif (!/^MIS-\\d{4}-\\d{3,6}$/.test(rawRef)) {\n  return [\n    {\n      json: {\n        valid: false,\n        httpStatus: 400,\n        error: \u0027Format de référence mission invalide.\u0027\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      valid: true,\n      mission_ref: rawRef\n    }\n  }\n];"
                                     },
