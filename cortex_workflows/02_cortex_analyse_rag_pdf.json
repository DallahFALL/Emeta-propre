                                         "jsCode":  "try {\n  const rows = $input.all();\n  const mission = $(\u0027Initialisation standardisée\u0027).first().json.mission.body || $(\u0027Initialisation standardisée\u0027).first().json.mission;\n  const contexts = rows.flatMap(row =\u003e row.json.result || []).map((hit, index) =\u003e `Source ${index + 1} (score ${hit.score}): ${JSON.stringify(hit.payload || {})}`).join(\u0027\\n\u0027);\n  const chapters = [\u0027Synthèse exécutive\u0027,\u0027Périmètre et méthode\u0027,\u0027Contexte organisationnel\u0027,\u0027Gouvernance\u0027,\u0027Modèle opérationnel\u0027,\u0027Marché et parties prenantes\u0027,\u0027Analyse financière\u0027,\u0027Trésorerie et financement\u0027,\u0027Ressources humaines\u0027,\u0027Systèmes et données\u0027,\u0027Cybersécurité et continuité\u0027,\u0027Conformité et réglementation\u0027,\u0027Risques stratégiques\u0027,\u0027Risques opérationnels\u0027,\u0027Scénarios et sensibilités\u0027,\u0027Indicateurs de performance\u0027,\u0027Options d’arbitrage\u0027,\u0027Plan d’action priorisé\u0027,\u0027Limites et hypothèses\u0027,\u0027Sources et annexes\u0027];\n  const prompt = `Tu es analyste e-META LABS. Rédige un audit factuel, en français, sans inventer de données. Distingue faits, hypothèses et recommandations. Signale les informations manquantes. Structure le rapport selon ces 20 chapitres, dans cet ordre : ${chapters.map((name, index) =\u003e `${index + 1}. ${name}`).join(\u0027; \u0027)}.\\n\\nSaisine : ${JSON.stringify(mission)}\\n\\nContexte documentaire récupéré :\\n${contexts}`;\n  const optionB = /option\\s*b|arbitrage\\s*terrain|expert\\s*terrain/i.test(`${mission.action || \u0027\u0027} ${mission.mission_contexte || \u0027\u0027} ${mission.message || \u0027\u0027}`);\n  return [{ json: { ...mission, rag_context: contexts, audit_prompt: prompt, option_b: optionB } }];\n} catch (err) { throw new Error(`Mapping contexte RAG impossible: ${err.message}`); }"
                                     },
