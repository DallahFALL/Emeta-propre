    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const rows = $input.all();\n  const mission = $('Initialisation standardisée').first().json.mission.body || $('Initialisation standardisée').first().json.mission;\n  const contexts = rows.flatMap(row => row.json.result || []).map((hit, index) => `Source ${index + 1} (score ${hit.score}): ${JSON.stringify(hit.payload || {})}`).join('\\n');\n  const chapters = ['Synthèse exécutive','Périmètre et méthode','Contexte organisationnel','Gouvernance','Modèle opérationnel','Marché et parties prenantes','Analyse financière','Trésorerie et financement','Ressources humaines','Systèmes et données','Cybersécurité et continuité','Conformité et réglementation','Risques stratégiques','Risques opérationnels','Scénarios et sensibilités','Indicateurs de performance','Options d’arbitrage','Plan d’action priorisé','Limites et hypothèses','Sources et annexes'];\n  const prompt = `Tu es analyste e-META LABS. Rédige un audit factuel, en français, sans inventer de données. Distingue faits, hypothèses et recommandations. Signale les informations manquantes. Structure le rapport selon ces 20 chapitres, dans cet ordre : ${chapters.map((name, index) => `${index + 1}. ${name}`).join('; ')}.\\n\\nSaisine : ${JSON.stringify(mission)}\\n\\nContexte documentaire récupéré :\\n${contexts}`;\n  const optionB = /option\\s*b|arbitrage\\s*terrain|expert\\s*terrain/i.test(`${mission.action || ''} ${mission.mission_contexte || ''} ${mission.message || ''}`);\n  return [{ json: { ...mission, rag_context: contexts, audit_prompt: prompt, option_b: optionB } }];\n} catch (err) { throw new Error(`Mapping contexte RAG impossible: ${err.message}`); }"
      },
