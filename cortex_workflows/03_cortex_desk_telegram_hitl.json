                                         "jsonBody":  "={{\n  (() =\u003e {\n    const safeFirst = (name) =\u003e {\n      try { return $(name).first()?.json || {}; } catch (_) { return {}; }\n    };\n\n    const rawWebhook = safeFirst(\u0027Webhook Rapport\u0027);\n    const webhookBody = (rawWebhook.body \u0026\u0026 typeof rawWebhook.body === \u0027object\u0027) ? rawWebhook.body : rawWebhook;\n    const initData = safeFirst(\u0027Initialisation standardisée\u0027);\n    const initialCtx = safeFirst(\u0027Conserver contexte initial HITL\u0027);\n    const revisedCtx = safeFirst(\u0027Conserver contexte révisé\u0027);\n\n    const merged = {\n      ...webhookBody,\n      ...initData,\n      ...initialCtx,\n      ...revisedCtx\n    };\n\n    const ref = String(\n      merged.reference_mission ||\n      merged.mission_ref ||\n      merged.Mission_Ref ||\n      merged.reference ||\n      webhookBody.reference_mission ||\n      webhookBody.mission_ref ||\n      \u0027\u0027\n    ).trim();\n\n    return {\n      ...merged,\n      reference_mission: ref,\n      mission_ref: ref,\n      Mission_Ref: ref,\n      whatsapp: merged.whatsapp || merged.telephone || webhookBody.whatsapp || webhookBody.telephone || \u0027\u0027,\n      telephone: merged.telephone || merged.whatsapp || webhookBody.telephone || webhookBody.whatsapp || \u0027\u0027,\n      empreinte_sha256: merged.empreinte_sha256 || merged.sha256_hash || webhookBody.empreinte_sha256 || \u0027\u0027,\n      quality_gate: $json,\n              action: \u0027validate\u0027,\n        pdf_base64: $(\u0027Préparer synthèse Desk\u0027).first().json.pdf_base64 || $(\u0027Initialisation standardisée\u0027).first().json.pdf_base64 || \u0027\u0027\n    };\n  })()\n}}",
