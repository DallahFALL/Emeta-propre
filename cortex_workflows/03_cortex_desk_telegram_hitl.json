        "jsCode": "try {\n  const mission = $('Préparer synthèse Desk').first().json;\n  const instructions = String($json.query.instructions || $json.query.consigne || '').trim();\n  if (!instructions) throw new Error('Une consigne de révision est obligatoire.');\n  return [{ json: { ...mission, revision_instructions: instructions, audit_prompt: `Révise le rapport d’audit ci-dessous en suivant uniquement les consignes, sans inventer de faits. Préserve les 20 chapitres et indique les limites.\\n\\nConsignes : ${instructions}\\n\\nRapport : ${mission.report_text || ''}\\n\\nContexte : ${JSON.stringify(mission)}` } }];\n} catch (err) { throw new Error(`Capture des consignes impossible: ${err.message}`); }"
      },
