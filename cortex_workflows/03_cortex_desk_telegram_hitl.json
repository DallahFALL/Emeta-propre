    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const mission = $json.mission.body || $json.mission;\n  const report = mission.report_text || 'Rapport disponible via le lien sécurisé.';\n  const summary = report.replace(/[#*_`>]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 850);\n  const chatId = mission.telegram_chat_id;\n  if (!chatId) throw new Error('telegram_chat_id du Desk Exécutif manquant.');\n  if (!mission.pdf_url && !mission.webViewLink) throw new Error('URL du rapport PDF manquante.');\n  return [{ json: { ...mission, summary, pdf_url: mission.pdf_url || mission.webViewLink, telegram_chat_id: chatId } }];\n} catch (err) { throw new Error(`Préparation Desk impossible: ${err.message}`); }"
      },
