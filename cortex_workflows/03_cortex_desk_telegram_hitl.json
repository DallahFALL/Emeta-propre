                                         "jsCode":  "try {\n  const mission = $json.mission?.body || $json.mission || $json;\n  const report = mission.report_text || \u0027Rapport disponible via le lien sécurisé.\u0027;\n  const summary = report.replace(/[#*_`\u003e]/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim().slice(0, 850);\n  const chatId = String(mission.telegram_chat_id || $json.telegram_chat_id || \u00278878273150\u0027);\n  const pdfBase64 = mission.pdf_base64 || $json.pdf_base64 || \u0027\u0027;\n  const pdfUrl = mission.pdf_url || mission.webViewLink || \u0027\u0027;\n  const hasBinary = typeof $binary !== \u0027undefined\u0027 \u0026\u0026 $binary \u0026\u0026 Object.keys($binary).length \u003e 0;\n\n  if (!pdfUrl \u0026\u0026 !pdfBase64 \u0026\u0026 !hasBinary) {\n    throw new Error(\u0027URL ou fichier binaire du rapport PDF manquant.\u0027);\n  }\n\n  const fileName = `${mission.reference_mission || mission.Code_Mission || \u0027Rapport_Audit_eMETA\u0027}.pdf`;\n  const binaryOutput = pdfBase64\n    ? { data: { data: pdfBase64, mimeType: \u0027application/pdf\u0027, fileName } }\n    : (hasBinary ? $binary : undefined);\n\n  return [{\n    json: {\n      ...mission,\n      summary,\n      pdf_url: pdfUrl,\n      telegram_chat_id: chatId\n    },\n    ...(binaryOutput ? { binary: binaryOutput } : {})\n  }];\n} catch (err) {\n  throw new Error(`Préparation Desk impossible: ${err.message}`);\n}"
